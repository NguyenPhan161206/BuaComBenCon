<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="@string/distribution_title"
        android:id="@+id/page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="29sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Kiểm tra đúng mã, xác nhận sau khi giao suất."
        android:id="@+id/page_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="12dp" />
    <View
        android:layout_width="1px"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Chọn đợt hỗ trợ  ⌄"
        android:id="@+id/campaign_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/green"
        android:fontFamily="sans-serif-medium"
        android:padding="16dp"
        android:minHeight="54dp"
        android:background="@drawable/ui_picker" />
    <View
        android:layout_width="1px"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/ui_card_pale"
        android:layout_marginBottom="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:id="@+id/metrics"
            android:layout_marginTop="18dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <vn.edu.buacombencon.UiTextView
                    style="@style/UiText"
                    android:text="0"
                    android:id="@+id/metric_value_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="27sp"
                    android:textColor="@color/green"
                    android:fontFamily="sans-serif-medium" />
                <vn.edu.buacombencon.UiTextView
                    style="@style/UiText"
                    android:text="Thực chuẩn bị"
                    android:id="@+id/metric_name_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/muted"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <vn.edu.buacombencon.UiTextView
                    style="@style/UiText"
                    android:text="0"
                    android:id="@+id/metric_value_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="27sp"
                    android:textColor="@color/green"
                    android:fontFamily="sans-serif-medium" />
                <vn.edu.buacombencon.UiTextView
                    style="@style/UiText"
                    android:text="Đã trao"
                    android:id="@+id/metric_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/muted"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <vn.edu.buacombencon.UiTextView
                    style="@style/UiText"
                    android:text="0"
                    android:id="@+id/metric_value_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="27sp"
                    android:textColor="@color/green"
                    android:fontFamily="sans-serif-medium" />
                <vn.edu.buacombencon.UiTextView
                    style="@style/UiText"
                    android:text="Chưa trao"
                    android:id="@+id/metric_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/muted"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/card_white"
        android:layout_marginBottom="14dp">
        <vn.edu.buacombencon.UiIcon
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            app:iconKind="scan"
            app:iconColor="@color/green" />
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="Nhập mã nhận suất"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="21sp"
            android:textColor="@color/ink"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="18dp" />
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="Nhờ người nhận đọc mã ngắn bên dưới QR."
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:fontFamily="sans-serif"
            android:layout_marginTop="8dp" />
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="Mã ngắn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/ink"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp"
            android:labelFor="@id/claim_code" />
        <vn.edu.buacombencon.UiEditText
            style="@style/UiInput"
            android:id="@+id/claim_code"
            android:hint="Ví dụ: BC0013"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:layout_marginTop="8dp" />
        <vn.edu.buacombencon.UiButton
            style="@style/UiPrimaryButton"
            android:id="@+id/check_code_action"
            android:text="Kiểm tra mã" />
        <vn.edu.buacombencon.UiButton
            style="@style/UiSecondaryButton"
            android:id="@+id/sample_code_action"
            android:text="Dùng mã mẫu BC0013" />
    </LinearLayout>
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Bản UI hiện hỗ trợ nhập mã ngắn. Quét QR bằng camera sẽ cần tích hợp ở bước phát triển chức năng."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp" />
    <View
        android:layout_width="1px"
        android:layout_height="10dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiSwitch
        android:id="@+id/network_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mô phỏng có kết nối"
        android:textSize="14sp"
        android:textColor="@color/ink"
        android:minHeight="52dp"
        android:checked="true" />
    <vn.edu.buacombencon.UiButton
        style="@style/UiSecondaryButton"
        android:id="@+id/distribution_help_action"
        android:text="Cần điều phối viên hỗ trợ" />
</LinearLayout>
