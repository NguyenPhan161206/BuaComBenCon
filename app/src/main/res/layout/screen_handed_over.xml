<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Những suất đã trao"
        android:id="@+id/page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="29sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Ghi nhận trong đợt đang phụ trách · Dữ liệu mẫu"
        android:id="@+id/page_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="12dp" />
    <View
        android:layout_width="1px"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Chọn đợt hỗ trợ  ⌄"
        android:id="@+id/campaign_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/green"
        android:fontFamily="sans-serif-medium"
        android:padding="16dp"
        android:minHeight="54dp"
        android:background="@drawable/ui_picker" />
    <View
        android:layout_width="1px"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/ui_card_pale"
        android:layout_marginBottom="14dp">
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="12 suất đã trao"
            android:id="@+id/handover_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textColor="@color/green"
            android:fontFamily="sans-serif-medium" />
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="Bữa trưa ấm lòng"
            android:id="@+id/handover_campaign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:fontFamily="sans-serif"
            android:layout_marginTop="10dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/handed_over_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
