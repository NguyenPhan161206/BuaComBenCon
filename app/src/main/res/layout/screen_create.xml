<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Thêm đợt hỗ trợ"
        android:id="@+id/page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="29sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Một nhóm tổ chức · Một điểm phát minh họa"
        android:id="@+id/page_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="12dp" />
    <View
        android:layout_width="1px"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Tên đợt hỗ trợ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp"
        android:labelFor="@id/create_title" />
    <vn.edu.buacombencon.UiEditText
        style="@style/UiInput"
        android:id="@+id/create_title"
        android:hint="Tên đợt hỗ trợ"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Sau bao nhiêu ngày? (0 = hôm nay)"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp"
        android:labelFor="@id/create_day" />
    <vn.edu.buacombencon.UiEditText
        style="@style/UiInput"
        android:id="@+id/create_day"
        android:text="1"
        android:hint="Sau bao nhiêu ngày? (0 = hôm nay)"
        android:inputType="number"
        android:maxLines="1"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Khung giờ nhận suất"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp"
        android:labelFor="@id/create_time" />
    <vn.edu.buacombencon.UiEditText
        style="@style/UiInput"
        android:id="@+id/create_time"
        android:text="11:00 – 12:00"
        android:hint="Khung giờ nhận suất"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Số suất đã xác nhận cung cấp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp"
        android:labelFor="@id/create_capacity" />
    <vn.edu.buacombencon.UiEditText
        style="@style/UiInput"
        android:id="@+id/create_capacity"
        android:text="30"
        android:hint="Số suất đã xác nhận cung cấp"
        android:inputType="number"
        android:maxLines="1"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Thời hạn đăng ký"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp"
        android:labelFor="@id/create_deadline" />
    <vn.edu.buacombencon.UiEditText
        style="@style/UiInput"
        android:id="@+id/create_deadline"
        android:text="18:00 ngày trước buổi phát"
        android:hint="Thời hạn đăng ký"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Tiêu chí và quy tắc sắp xếp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp"
        android:labelFor="@id/create_rules" />
    <vn.edu.buacombencon.UiEditText
        style="@style/UiInput"
        android:id="@+id/create_rules"
        android:text="Mỗi người chăm sóc 1 suất; hồ sơ đủ điều kiện được sắp xếp theo thứ tự đăng ký."
        android:hint="Tiêu chí và quy tắc sắp xếp"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:layout_marginTop="8dp" />
    <Spinner
        style="@style/UiSpinner"
        android:id="@+id/create_meal" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Điểm phát: An Tâm · khu sinh hoạt chung (mẫu). Đợt mới được lưu trên thiết bị này để thử giao diện."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp" />
    <View
        android:layout_width="1px"
        android:layout_height="10dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiButton
        style="@style/UiPrimaryButton"
        android:id="@+id/submit_create"
        android:text="Tạo đợt hỗ trợ" />
</LinearLayout>
