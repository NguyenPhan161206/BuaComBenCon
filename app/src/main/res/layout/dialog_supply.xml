<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="8dp"
    tools:context=".MainActivity">
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Số xác nhận cung cấp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiEditText
        style="@style/UiInput"
        android:id="@+id/supply_confirmed"
        android:hint="Số suất"
        android:inputType="number"
        android:maxLines="1" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Số thực chuẩn bị"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp" />
    <vn.edu.buacombencon.UiEditText
        style="@style/UiInput"
        android:id="@+id/supply_prepared"
        android:hint="Số suất"
        android:inputType="number"
        android:maxLines="1" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Ghi chú xử lý phần chưa trao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp" />
    <vn.edu.buacombencon.UiEditText
        style="@style/UiInput"
        android:id="@+id/supply_note"
        android:hint="Cách xử lý thực tế"
        android:inputType="textMultiLine"
        android:maxLines="5" />
</LinearLayout>
