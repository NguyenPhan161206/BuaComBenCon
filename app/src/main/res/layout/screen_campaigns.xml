<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Đợt hỗ trợ"
        android:id="@+id/page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="29sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Theo dõi từ đăng ký đến đối chiếu sau buổi phát."
        android:id="@+id/page_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="12dp" />
    <View
        android:layout_width="1px"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiButton
        style="@style/UiPrimaryButton"
        android:id="@+id/create_action"
        android:text="+  Tạo đợt hỗ trợ" />
    <View
        android:layout_width="1px"
        android:layout_height="8dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/campaign_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
