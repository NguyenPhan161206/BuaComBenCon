<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Suất ăn đã sẵn sàng"
        android:id="@+id/page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="29sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Bữa trưa ấm lòng"
        android:id="@+id/page_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="12dp" />
    <View
        android:layout_width="1px"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/card_white"
        android:layout_marginBottom="14dp"
        android:gravity="center_horizontal">
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="Được nhận"
            android:id="@+id/ticket_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/green"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/ui_pill" />
        <LinearLayout
            android:id="@+id/ticket_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal" />
    </LinearLayout>
    <View
        android:layout_width="1px"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <vn.edu.buacombencon.UiIcon
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:iconKind="calendar"
            app:iconColor="@color/green" />
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="20/11 · 11:00 – 12:00"
            android:id="@+id/ticket_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:fontFamily="sans-serif"
            android:layout_weight="1"
            android:layout_marginLeft="10dp" />
    </LinearLayout>
    <View
        android:layout_width="1px"
        android:layout_height="14dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <vn.edu.buacombencon.UiIcon
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:iconKind="pin"
            app:iconColor="@color/green" />
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="Điểm phát An Tâm"
            android:id="@+id/ticket_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:fontFamily="sans-serif"
            android:layout_weight="1"
            android:layout_marginLeft="10dp" />
    </LinearLayout>
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Khi đến nhận"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="22dp" />
    <View
        android:layout_width="1px"
        android:layout_height="12dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Xuất trình QR hoặc đọc mã ngắn. Không dùng được điện thoại? Bạn có thể nhờ điều phối viên hỗ trợ trực tiếp tại điểm phát."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp" />
    <View
        android:layout_width="1px"
        android:layout_height="10dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiButton
        style="@style/UiSecondaryButton"
        android:id="@+id/cancel_registration_action"
        android:text="Tôi không thể đến nhận"
        android:visibility="gone" />
</LinearLayout>
