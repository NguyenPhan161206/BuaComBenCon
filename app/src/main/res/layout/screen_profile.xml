<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Không gian của bạn"
        android:id="@+id/page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="29sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Bạn đang xem vai trò người chăm sóc."
        android:id="@+id/page_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="12dp" />
    <View
        android:layout_width="1px"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/card_white"
        android:layout_marginBottom="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <vn.edu.buacombencon.UiIcon
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:iconKind="user"
                app:iconColor="@color/green" />
            <vn.edu.buacombencon.UiTextView
                style="@style/UiText"
                android:text="Người chăm sóc"
                android:id="@+id/profile_role"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:fontFamily="sans-serif"
                android:layout_weight="1"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="Tài khoản trình diễn · Chưa đăng nhập hệ thống thật"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:fontFamily="sans-serif"
            android:layout_marginTop="12dp" />
        <vn.edu.buacombencon.UiButton
            style="@style/UiPrimaryButton"
            android:id="@+id/profile_role_action"
            android:text="Đổi vai trò để xem giao diện" />
    </LinearLayout>
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Thông tin của bạn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="22dp" />
    <View
        android:layout_width="1px"
        android:layout_height="12dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Dữ liệu nhập được lưu trong bộ nhớ riêng của ứng dụng trên thiết bị, dùng để thử giao diện. Bản UI chưa kết nối máy chủ, thanh toán, gửi tin nhắn hoặc camera."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp" />
    <View
        android:layout_width="1px"
        android:layout_height="10dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Quyền riêng tư của gia đình"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="22dp" />
    <View
        android:layout_width="1px"
        android:layout_height="12dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Không yêu cầu tên trẻ, hình ảnh hay bệnh án. Báo cáo dành cho nhà hảo tâm chỉ chứa số liệu tổng hợp."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp" />
    <View
        android:layout_width="1px"
        android:layout_height="10dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiButton
        style="@style/UiSecondaryButton"
        android:id="@+id/profile_guide_action"
        android:text="Hướng dẫn trình diễn" />
    <vn.edu.buacombencon.UiButton
        style="@style/UiSecondaryButton"
        android:id="@+id/profile_reset_action"
        android:text="Khôi phục dữ liệu mẫu" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="BỮA CƠM BÊN CON  /  MEALS BESIDE YOU"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="@color/green"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="28dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Đồ án giao diện Android · Phiên bản 1.0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp" />
</LinearLayout>
