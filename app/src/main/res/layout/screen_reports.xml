<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="@string/reports_title"
        android:id="@+id/page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="29sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Báo cáo tổng hợp · Tất cả số liệu là minh họa"
        android:id="@+id/page_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="12dp" />
    <View
        android:layout_width="1px"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Chọn đợt hỗ trợ  ⌄"
        android:id="@+id/campaign_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/green"
        android:fontFamily="sans-serif-medium"
        android:padding="16dp"
        android:minHeight="54dp"
        android:background="@drawable/ui_picker" />
    <View
        android:layout_width="1px"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/report_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    <vn.edu.buacombencon.UiButton
        style="@style/UiSecondaryButton"
        android:id="@+id/report_edit_action"
        android:text="Cập nhật thực chuẩn bị &amp; ghi chú"
        android:visibility="gone" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Hiểu đúng các con số"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="22dp" />
    <View
        android:layout_width="1px"
        android:layout_height="12dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Cam kết là mong muốn hỗ trợ, chưa mặc định đã có suất. Xác nhận cung cấp là khả năng đơn vị đã thống nhất. Thực chuẩn bị được ghi cho buổi phát. Đã trao là lượt đã được xác nhận giao."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp" />
    <View
        android:layout_width="1px"
        android:layout_height="10dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Báo cáo chỉ sử dụng số liệu tổng hợp, không hiển thị danh tính hoặc thông tin bệnh án của trẻ."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp" />
    <View
        android:layout_width="1px"
        android:layout_height="10dp"
        android:importantForAccessibility="no" />
</LinearLayout>
