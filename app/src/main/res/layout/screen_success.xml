<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <View
        android:layout_width="1px"
        android:layout_height="20dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiIcon
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        app:iconKind="check"
        app:iconColor="@color/green" />
    <View
        android:layout_width="1px"
        android:layout_height="22dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="@string/registration_success_title"
        android:id="@+id/page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="29sp"
        android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Đơn vị tổ chức sẽ kiểm tra và cập nhật kết quả sắp xếp suất."
        android:id="@+id/page_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="12dp" />
    <View
        android:layout_width="1px"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/card_white"
        android:layout_marginBottom="14dp">
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="Thêm một bữa cơm lành"
            android:id="@+id/success_campaign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/ink"
            android:fontFamily="sans-serif-medium" />
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="21/11 · 1 suất ăn"
            android:id="@+id/success_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:fontFamily="sans-serif"
            android:layout_marginTop="10dp" />
        <View
            android:layout_width="1px"
            android:layout_height="14dp"
            android:importantForAccessibility="no" />
        <vn.edu.buacombencon.UiTextView
            style="@style/UiText"
            android:text="Đã tiếp nhận · Chưa cấp mã nhận"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/ui_orange"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/ui_pill_warning" />
    </LinearLayout>
    <vn.edu.buacombencon.UiTextView
        style="@style/UiText"
        android:text="Gửi đăng ký chưa bảo đảm có suất. Bạn có thể xem trạng thái trong Đăng ký của tôi. Nếu hết suất, hồ sơ sẽ vào danh sách chờ."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp" />
    <View
        android:layout_width="1px"
        android:layout_height="10dp"
        android:importantForAccessibility="no" />
    <vn.edu.buacombencon.UiButton
        style="@style/UiPrimaryButton"
        android:id="@+id/success_action"
        android:text="Theo dõi đăng ký" />
</LinearLayout>
