        android:fontFamily="sans-serif-medium"
        android:minHeight="48dp"
        android:gravity="center_vertical" />
    <View
        android:layout_width="1px"
        android:layout_height="8dp"
        android:importantForAccessibility="no" />
</LinearLayout>
